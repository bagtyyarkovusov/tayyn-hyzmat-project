# Never copy real credentials into this example or the offline bundle.
DOMAIN=dispatch.example.com
CORS_ORIGIN=https://dispatch.example.com,https://localhost,http://localhost,capacitor://localhost
# Generate URL-safe hex with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_generated_hex
JWT_ACCESS_SECRET=replace_with_separate_generated_hex
JWT_REFRESH_SECRET=replace_with_separate_generated_hex
SEED_ADMIN_PHONE=+99365999999
SEED_ADMIN_PASSWORD=replace_with_unique_production_password
TLS_CERT_PATH=/etc/tayyn/tls/fullchain.pem
TLS_KEY_PATH=/etc/tayyn/tls/privkey.pem
# Web Maps public key must already be baked into WEB_IMAGE at build time.
# Backend Geocoder key and Firebase service account remain runtime secrets.
YANDEX_GEOCODER_API_KEY=
# Zero keeps geocoding disabled until quota period and key are verified.
YANDEX_GEOCODER_DAILY_LIMIT=0
YANDEX_GEOCODER_QUOTA_TIMEZONE=
YANDEX_GEOCODER_QUOTA_RESET_HOUR=0
YANDEX_GEOCODER_CACHE_SECONDS=0
YANDEX_GEOCODER_REFERER=https://dispatch.example.com/
# Use one JSON line inside single quotes. Docker Compose env interpolation
# applies to unquoted and double-quoted values; single quotes preserve it.
FIREBASE_SERVICE_ACCOUNT_JSON=''
