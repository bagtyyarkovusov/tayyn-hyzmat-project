FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json .npmrc ./
COPY patches ./patches
RUN npm ci --no-audit --no-fund
COPY . .
ARG VUE_APP_YANDEX_MAPS_API_KEY=""
ENV VUE_APP_API_URL=/api VUE_APP_SOCKET_URL=/ VUE_APP_YANDEX_MAPS_API_KEY=$VUE_APP_YANDEX_MAPS_API_KEY
# Vue CLI 4 uses webpack 4, which needs the legacy OpenSSL provider on Node 22.
RUN NODE_OPTIONS=--openssl-legacy-provider npm run build

FROM nginx:1.28-alpine
ENV PORT=8080 API_UPSTREAM=http://api:4000
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
