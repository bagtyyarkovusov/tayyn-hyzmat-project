FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json ./backend/package.json
COPY legacy/package.json ./legacy/package.json
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
ARG VUE_APP_YANDEX_MAPS_API_KEY=""
ENV VITE_API_URL=/api VITE_SOCKET_URL=/ VITE_YANDEX_MAPS_API_KEY=$VUE_APP_YANDEX_MAPS_API_KEY VUE_APP_API_URL=/api VUE_APP_SOCKET_URL=/ VUE_APP_YANDEX_MAPS_API_KEY=$VUE_APP_YANDEX_MAPS_API_KEY
RUN pnpm build
FROM nginx:1.28-alpine
ENV PORT=8080 API_UPSTREAM=http://api:4000 NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
