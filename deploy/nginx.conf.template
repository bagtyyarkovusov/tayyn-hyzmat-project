server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Railway replaces API private addresses independently of this container.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=1s;
    resolver_timeout 5s;
    set $api_upstream ${API_UPSTREAM};

    location = /health {
        access_log off;
        proxy_pass $api_upstream/health;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /socket.io/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 75s;
    }
    location = /index.html { add_header Cache-Control "no-store"; }
    location = /driver.html { add_header Cache-Control "no-store"; }
    location = /service-worker.js { add_header Cache-Control "no-store"; }
    location /legacy/ { try_files $uri $uri/ /legacy/index.html; }
    location / { try_files $uri $uri/ /index.html; }
}
