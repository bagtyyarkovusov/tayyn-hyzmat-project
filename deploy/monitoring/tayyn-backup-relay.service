[Unit]
Description=Pull and verify encrypted Tayyn backups from the app VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tayyn-monitor
UMask=0077
ExecStart=/usr/bin/python3 /opt/tayyn/operations.py --config /etc/tayyn/operations.json relay
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tayyn
