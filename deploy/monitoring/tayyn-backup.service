[Unit]
Description=Tayyn hourly encrypted PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/tayyn/operations.py --config /etc/tayyn/operations.json backup
TimeoutStartSec=360
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tayyn
