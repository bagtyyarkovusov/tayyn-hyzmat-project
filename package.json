{
  "name": "tayyn-hyzmat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.33.2 <11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "serve": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && pnpm --filter @tayyn/legacy build",
    "build:modern": "vue-tsc --noEmit && vite build",
    "build:backend": "pnpm --filter openride-backend build",
    "typecheck": "vue-tsc --noEmit && pnpm --filter openride-backend typecheck",
    "test:unit": "pnpm --filter openride-backend test:unit",
    "test:integration": "pnpm --filter openride-backend test:integration",
    "test:e2e": "node scripts/test-browser.mjs",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "build:driver": "pnpm build:modern && node scripts/prepare-driver-dist.cjs",
    "cap:sync": "pnpm build:driver && cap sync android",
    "android:assembleDebug": "pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "android:assembleRelease": "pnpm cap:sync && cd android && ./gradlew assembleRelease",
    "preview:isolated": "node scripts/test-browser.mjs --serve",
    "format:check": "prettier --check src tests *.ts scripts/test-browser.mjs scripts/test-container-startup.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "^6.2.1",
    "@fontsource-variable/manrope": "^5.2.8",
    "@lucide/vue": "^1.57.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "npm:@lucide/vue@^1.57.0",
    "reka-ui": "^2.9.2",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.5.0",
    "vue": "3.5.44",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "^3.2.6"
  }
}
