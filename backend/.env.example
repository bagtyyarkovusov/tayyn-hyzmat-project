NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tayyn:replace-with-random-password@localhost:5432/tayyn
CORS_ORIGIN=http://localhost:8080
JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-random-refresh-secret
SEED_ADMIN_PHONE=+99360000000
SEED_ADMIN_PASSWORD=replace-with-random-admin-password
SEED_ADMIN_NAME=Development Admin

# Optional private HTTP Geocoder. Disabled until key + confirmed quota + timezone are set.
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_DAILY_LIMIT=
YANDEX_GEOCODER_QUOTA_TIMEZONE=
YANDEX_GEOCODER_QUOTA_RESET_HOUR=0
# Only enable positive retention if the provider contract permits it.
YANDEX_GEOCODER_CACHE_SECONDS=0
