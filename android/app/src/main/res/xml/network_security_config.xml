<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) blocks plain HTTP by default - this config keeps
  that default everywhere EXCEPT localhost/10.0.2.2, used only for local dev
  (adb reverse / the Android emulator's alias for the host machine).

  The real server now has a real domain + Let's Encrypt TLS cert
  (https://taxi.atajan.org, see /etc/nginx/sites-available/openride on that
  box) - plain HTTPS to a publicly-trusted cert needs no cleartext
  exception at all, it's already covered by <base-config>'s system
  trust-anchors below. The previous temporary exception for the bare IP
  178.128.222.6 has been removed now that VUE_APP_API_URL/VUE_APP_SOCKET_URL
  point at the https:// domain instead - no cleartext traffic is permitted
  to anything but localhost any more, in dev or release builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
