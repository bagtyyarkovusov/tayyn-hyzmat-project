<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- android:background alone (the old Cordova/Capacitor-style full-bleed
         @drawable/splash image) is what this used to be. On Android 12+
         (the real device this was tested on runs Android 15), the actual
         system SplashScreen API - active here via the core-splashscreen
         dependency Capacitor's BridgeActivity wires up - ignores that and
         falls back to the app's adaptive launcher icon instead, centered
         using the OS's own icon-region rules. That foreground layer
         (mipmap/ic_launcher_foreground.png) turned out to have an opaque
         white background baked in rather than real transparency, which is
         its own separate bug - not something to reuse here. Setting
         windowSplashScreenAnimatedIcon/windowSplashScreenBackground
         explicitly (a from-scratch, properly centered, properly
         transparent icon - see drawable/splash_icon.png) takes the
         positioning out of guesswork about which of the two splash
         mechanisms a given OS version actually uses, on both. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>