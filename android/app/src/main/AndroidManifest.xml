<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service android:name=".ShiftService" android:exported="false" android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Permissions - one per actual feature this app uses, nothing broader.
      No CALL_PHONE: the client-phone "call" action (ActiveOrderPanel.vue)
      opens a `tel:` link, which Android resolves via ACTION_DIAL into the
      user's own dialer app with the number pre-filled - that needs no
      permission at all. CALL_PHONE would only be required to place a call
      directly without the user confirming in the dialer, which this app
      deliberately does not do.
    -->

    <!-- Talking to the backend (REST + Socket.IO). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Started only by a visible, explicit Online action; no background start/reboot restart. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declared, not required: a driver's device without real GPS hardware
         should still be installable and fail gracefully at runtime (the
         existing GpsRequiredModal already handles "GPS unavailable"),
         rather than being hard-excluded from the Play Store listing. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
</manifest>
